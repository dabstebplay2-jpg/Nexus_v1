# Скопируйте в deploy/.env на сервере: cp env.example .env

# === Cloud (nexus-cloud-server) ===
# ~93% цены подписки → месячный пул ИИ (787 ₽ → ~730 ₽ на RouterAI)
NEXUS_TIER_POOL_FRACTION=0.93
# Или вручную: TIER_HOBBY_MONTHLY_CAP_USD=10.2
NEXUS_CLOUD_SECRET_KEY=сгенерируйте-длинный-секрет
ROUTER_AI_MASTER_KEY=sk-ваш-мастер-ключ-routerai
ROUTER_AI_BASE_URL=https://routerai.ru/api/v1
ROUTER_AI_PROVISION_ON_REGISTER=true
# Никогда не включайте в проде — иначе все ходят в ИИ с вашего счёта:
ROUTER_AI_ALLOW_PLATFORM_INFERENCE=false

# Локальная разработка: кнопка «подтвердить оплату». На проде — false!
NEXUS_BILLING_TEST_MODE=false

NEXUS_CLOUD_DATABASE_URL=sqlite:////data/nexus_cloud_v2.db

# Домен фронта (Vercel), через запятую:
NEXUS_CORS_ORIGINS=https://ваш-проект.vercel.app,https://ваш-домен.ru

# === Backend (прокси + IDE API) ===
NEXUS_CLOUD_SERVER_URL=http://cloud:8080
NEXUS_CORS_ORIGINS=https://ваш-проект.vercel.app,https://ваш-домен.ru

# === Frontend (Vercel → Settings → Environment Variables) ===
# VITE_API_BASE=https://api.ваш-домен.ru/api
# VITE_DESKTOP_DOWNLOAD_URL=https://github.com/org/nexus-ide/releases/latest
