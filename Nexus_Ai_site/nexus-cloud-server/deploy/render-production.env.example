# Шаблон для локального deploy/render-production.env (файл в .gitignore).
# Скопируйте: cp deploy/render-production.env.example deploy/render-production.env

POLZA_BACKEND_API_KEY=pza-your-backend-key-here
POLZA_MCP_TOKEN=pza-mcp-token-here
POLZA_OAUTH_CALLBACK_URL=https://nexus-cloud-bxcc.onrender.com/v1/auth/polza/callback
POLZA_APP_NAME=Nexus
NEXUS_CLOUD_SECRET_KEY=generate-random-32-chars-minimum
NEXUS_CLOUD_DATABASE_URL=postgresql://user:pass@host/db
NEXUS_CORS_ORIGINS=https://your-frontend.vercel.app
NEXUS_BILLING_TEST_MODE=false
NEXUS_TESTING_MODE=false
NEXUS_REMOTE_ADMIN=true
NEXUS_ADMIN_PASSWORD=use-strong-password-here
NEXUS_ADMIN_GRANT_KEY=generate-random-grant-key-here
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
