# Скопируйте в deploy/render-production.env или nexus-cloud-server/.env (не коммитить)
# Ключи: https://yookassa.ru/my/merchant/integration/api-keys

YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=live_...
YOOKASSA_RETURN_PATH=/pricing
NEXUS_FRONTEND_URL=https://nexus-zeta-ruby-12.vercel.app
NEXUS_BILLING_TEST_MODE=false

# Webhook в кабинете ЮKassa (HTTP-уведомления):
# https://nexus-cloud-bxcc.onrender.com/v1/billing/yookassa/webhook
# Событие: payment.succeeded
