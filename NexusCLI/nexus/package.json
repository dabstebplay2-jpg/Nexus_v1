{
  "name": "@nexuscli/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "nexus": "./apps/cli/index.ts"
  },
  "scripts": {
    "dev": "bun apps/cli/index.ts",
    "test": "bun test ./test",
    "check": "bun run script/check.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run script/build.ts",
    "bench": "bun run bench/run.ts",
    "check:boundaries": "bun run script/boundaries.ts",
    "smoke": "bun run script/smoke.ts",
    "format:check": "prettier --check src apps test script bench/run.ts bench/oracle.ts docs README.md"
  },
  "dependencies": {
    "diff": "8.0.2",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "bun": "1.3.14",
    "prettier": "3.6.2",
    "typescript": "5.8.2"
  }
}
