{
  "name": "axiom",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:packages && concurrently -k -n packages,api,chat \"tsc -b tsconfig.packages.json --watch --preserveWatchOutput\" \"npm run dev -w @axiom/server\" \"npm run dev -w @axiom/chat\"",
    "lint": "eslint .",
    "typecheck": "npm run build:packages && tsc --noEmit",
    "test": "npm run build:packages && tsx --test tests/*.test.ts",
    "build": "npm run typecheck && npm run build -w @axiom/chat && npm run build -w @axiom/server",
    "start": "node apps/server/dist/index.js",
    "test:e2e": "playwright test",
    "build:packages": "tsc -b tsconfig.packages.json",
    "release:source": "node scripts/create-source-archive.mjs",
    "pack:source": "node scripts/create-source-archive.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.0"
  }
}
